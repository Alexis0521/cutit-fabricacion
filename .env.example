# Copy to .env and provide values for your environment.
POSTGRES_DB=cutit
POSTGRES_USER=cutit_user
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://cutit_user:replace_with_a_local_password@db:5432/cutit
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
MATERIALES_BASE_URL=http://materiales-service:8001
INVENTARIO_BASE_URL=http://inventario-service:8002
NOTIFICACIONES_BASE_URL=http://notificaciones-service:8003
EXTERNAL_TIMEOUT_SECONDS=5
EXTERNAL_MODE=mock
CALLBACK_API_KEY=replace_with_callback_key
